{
  "name": "tnajem",
  "version": "0.1.0",
  "private": true,
  "description": "Tnajem (تنجّم) — Shopify for Tunisian tutors. MVP. Local Postgres + Drizzle.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tnajem/web",
    "build": "npm run build -w @tnajem/web && npm run build -w @tnajem/api",
    "start": "npm run start -w @tnajem/web",
    "start:standalone": "npm run start:standalone -w @tnajem/web",
    "lint": "npm run lint -w @tnajem/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "npm run test -w @tnajem/api && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test --config=e2e/docker.config.ts",
    "db:sql": "npm run db:sql -w @tnajem/db --",
    "db:check": "npm run db:check -w @tnajem/db --",
    "db:backup": "npm run db:backup -w @tnajem/db --",
    "db:restore": "npm run db:restore -w @tnajem/db --",
    "db:encrypt-docs": "npm run db:encrypt-docs -w @tnajem/db --",
    "verify": "npm run typecheck && npm run lint && node tools/ui-audit/contrast.mjs && node tools/ui-audit/guardrails.mjs",
    "db:purge": "npm run db:purge -w @tnajem/db --",
    "db:seed": "npm run db:seed -w @tnajem/db --",
    "db:studio": "npm run db:studio -w @tnajem/db --",
    "db:push": "echo \"BLOCKED: drizzle-kit 0.28 is not PostgreSQL 18-safe (it tries to DROP the NOT NULL constraints on ~60 columns). Use \\\"npm run db:sql\\\" instead - see packages/db/sql/. Details in packages/db/bin/apply-sql.ts.\" && exit 1",
    "ui:audit": "node tools/ui-audit/contrast.mjs && node tools/ui-audit/guardrails.mjs && node tools/ui-audit/nojs.mjs && node tools/ui-audit/a11y.mjs && node tools/ui-audit/keyboard.mjs",
    "ui:shots": "node tools/ui-audit/shots.mjs",
    "ui:weight": "node tools/ui-audit/weight.mjs",
    "ui:lighthouse": "node tools/ui-audit/lighthouse.mjs",
    "ui:load": "node tools/ui-audit/load.mjs",
    "brand:build": "npm run brand:build -w @tnajem/web",
    "dev:api": "npm run dev -w @tnajem/api",
    "build:api": "npm run build -w @tnajem/api",
    "test:api": "npm run test -w @tnajem/api",
    "ui:shots-a": "playwright test -c e2e/visual/visual.config.ts option-a",
    "ui:shots-b": "playwright test -c e2e/visual/visual.config.ts auth-b",
    "ui:shots-ep2": "playwright test -c e2e/visual/visual.config.ts ep2-all",
    "ui:shots-lf1": "playwright test -c e2e/visual/visual.config.ts lf1-all",
    "ui:shots-lf2": "playwright test -c e2e/visual/visual.config.ts lf2-all",
    "ui:shots-lf3": "playwright test -c e2e/visual/visual.config.ts lf3-all"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "autocannon": "^8.0.0",
    "axe-core": "^4.13.0",
    "dotenv": "^16.4.5",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
