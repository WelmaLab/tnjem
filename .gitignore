# Patterns are UNANCHORED on purpose. A leading "/" anchors to the repo
# root, and once the app moved into apps/ every one of them stopped
# matching -- apps/web/.next (2208 files) went into a commit before this
# was noticed. Use "dir/" so it matches at any depth.
# Monorepo note

node_modules/
.next/
out/
dist/
.env*.local
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Uploaded verification documents (sensitive — never commit)
.storage/

# Env / secrets — keep only .env.example tracked
.env
.env.*
!.env.example

# UI-audit screenshots — regenerated by `node tools/ui-audit/shots.mjs`
tools/ui-audit/shots/

# UI-audit baselines
tools/ui-audit/shots-*/

# MCP browser console logs — scratch output, regenerated per session
.playwright-mcp/

# pm2 logs (ecosystem.config.cjs writes them next to the checkout on the server)
logs/

# E2E suite artifacts
.e2e-storage/
# Per-lane storage for Phase A worktrees (the lane-env helper points STORAGE_DIR here).
.lane-storage/
# db:backup output — every user's personal data. Never commit.
backups/
test-results/
playwright-report/
# UI Option A before/after screenshots (e2e/visual/option-a.capture.ts). Local only.
ui-option-a/
# Local Claude Code state (worktrees, agent scratch). Never committed. (Phase A+ U5)
.claude/
# Phase A+ screenshots (ui:shots-a → ui-a-plus/after, the cash-out capture). Local only.
ui-a-plus/

# ── Added 26 Sept 2026 ───────────────────────────────────────────────────────
# Tool caches and editor/OS noise
.impeccable/
.eslintcache
.cache/
.turbo/
coverage/
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
Thumbs.db
desktop.ini

# Secrets that must never be committed, whatever they are called
*.pem
*.key
*_rsa
*_ed25519
tnajem_actions*
tnajem.env
*secrets*.txt

# Database dumps anywhere in the tree (backups/ is already ignored)
*.dump
*.sql.gz
*.backup

# One-shot Claude Code prompts (kept on disk, not in the repo)
PHASE_A_TRUST_BLOCKERS.md
PHASE_A_PLUS.md
UI_OPTION_A.md
UI_AUTH_OPTION_B.md
UI_AUTH_B_REPORT.md
# Auth Option B screenshots (e2e/visual/auth-b.capture.ts). Local only.
ui-auth-b/
ESPACE_PROF_V2.md
ESPACE_PROF_V2_REPORT.md
# Espace prof v2 screenshots (Phase 8). Local only.
ui-espace-prof-v2/
LIVE_FIXES_1.md
LIVE_FIXES_1_REPORT.md
# Live fixes 1 screenshots (section K). Local only.
ui-live-fixes-1/
LIVE_FIXES_2.md
LIVE_FIXES_2_REPORT.md
# Live fixes 2 screenshots (section F). Local only.
ui-live-fixes-2/
