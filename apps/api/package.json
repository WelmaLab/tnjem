    "@fastify/multipart": "^10.1.1",
    "@sentry/node": "^10.74.0",
    "@tnajem/db": "*",
    "@tnajem/shared": "*",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
